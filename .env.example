## LLM (Answering)
ANTHROPIC_API_KEY=
# Use a model id from Anthropic docs (e.g. claude-sonnet-4-20250514). Avoid deprecated "-latest" slugs.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

## Source site (Squarespace)
SITE_BASE_URL=https://www.orlandoeaglessoccer.com
SITE_SITEMAP_URL=https://www.orlandoeaglessoccer.com/sitemap.xml

## Behavior
CONTACT_EMAIL=info@orlandoeaglessoccer.com
CONTACT_ADDRESS=1395 Campus View Ct, Oviedo, FL 32765
# Free assistant replies per browser (server-enforced). Widget: data-free-uses / data-contact-email.
CHAT_FREE_USES=5
# Change to reset server-side usage keys (pepper for hashing client ids).
RATE_LIMIT_PEPPER=orlando-eagles-rate-v1
# Optional: override JSON store path (default: OS temp dir, e.g. /tmp on Vercel).
# EAGLES_RATE_LIMIT_FILE=

## Local index storage
INDEX_PATH=data/eagles-index.json

## Reindex protection (only for /api/reindex)
REINDEX_SECRET=

